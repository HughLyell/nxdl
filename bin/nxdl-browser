#!/usr/bin/env bash
set -euo pipefail

SELF="$(command -v -- "$0" 2>/dev/null || true)"
[ -n "$SELF" ] || SELF="$0"
SELF="$(readlink -f "$SELF")"
BINDIR="$(dirname "$SELF")"

NODE="${NXDL_NODE:-$HOME/.nix-profile/bin/node}"
[ -x "$NODE" ] || NODE="$(command -v node || true)"
[ -n "$NODE" ] || { echo "nxdl-browser: node not found (set NXDL_NODE)" >&2; exit 1; }

SCRIPT=""
for c in \
  "${NXDL_HOME:-}/browser-dl.mjs" \
  "$HOME/.local/share/nxdl/browser-dl.mjs" \
  "$BINDIR/../lib/browser-dl.mjs" \
  "$BINDIR/../src/browser-dl.mjs" \
  "$BINDIR/browser-dl.mjs"
do
  if [ -n "$c" ] && [ -f "$c" ]; then SCRIPT="$c"; break; fi
done
[ -n "$SCRIPT" ] || { echo "nxdl-browser: browser-dl.mjs not found (set NXDL_HOME)" >&2; exit 1; }

if [ -x "$BINDIR/nxdl-chrome" ]; then
  "$BINDIR/nxdl-chrome" >&2
elif command -v nxdl-chrome >/dev/null 2>&1; then
  nxdl-chrome >&2
else
  echo "nxdl-browser: nxdl-chrome not found" >&2; exit 1
fi

exec "$NODE" "$SCRIPT" "$@"
